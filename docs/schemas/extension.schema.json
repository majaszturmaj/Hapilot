{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hapilot.extension/1",
  "title": "Hapilot extension manifest (hapilot_extension.json), version 1",
  "type": "object",
  "required": ["manifest_version", "id", "name"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "author": {"type": "string"},
    "license": {"type": "string"},
    "enabled": {"type": "boolean", "default": true},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "entry_point"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
          "entry_point": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$"},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "then": {"type": "string", "description": "always continue with this node"},
          "after": {
            "type": "object",
            "required": ["policy"],
            "additionalProperties": false,
            "properties": {
              "policy": {"enum": ["plan", "on_success", "retry"]},
              "retry_to": {"type": "string"},
              "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10}
            },
            "if": {"properties": {"policy": {"const": "retry"}}},
            "then": {"required": ["retry_to"]}
          }
        },
        "not": {"required": ["then", "after"]}
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"},
          "node": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "when_to_use": {"type": "string"},
          "when_not_to_use": {"type": "string"},
          "example": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$"}}
        }
      }
    },
    "prompts": {"type": "object", "additionalProperties": {"type": "string"}},
    "hooks": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$"},
    "config": {"type": "object"},
    "routes": {"description": "ignored (manifests before version 1)"}
  }
}
