# Hapilot - Environment Configuration (.env)

# ============================================================================
# PLAN MODE: Controls complex query handling
# ============================================================================
# Options:
#   auto      - Automatically detect complex queries and decompose (DEFAULT)
#   explicit  - Only plan when user explicitly requests it
#   off       - No planning, sequential execution
#
PLAN_MODE=auto

# ============================================================================
# STATE PERSISTENCE: For long-running, multi-step tasks
# ============================================================================
# Directory where task states will be persisted (JSON files)
# Each complex task gets a unique ID and state file
#
STATE_PERSISTENCE_DIR=./task_states

# ============================================================================
# LLM MODELS: Specialized model endpoints
# ============================================================================

# --- Bielik (Router, Knowledge, Task Planner) ---
# Local LM Studio instance with Bielik-11B-v2.3-Instruct
# Handles: Intent routing, document retrieval, complex query decomposition
#
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_MODEL_ID=bielik-11b-v3.0-instruct

# --- Qwen Coder (Python Code Generation) ---
# Remote Qwen3-Coder-30B for Python code generation
# Handles: Python code generation ONLY (auto-fallback to Bielik if unavailable)
#
REMOTE_CODER_URL=http://127.0.0.1:1235/v1
REMOTE_MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8

# ============================================================================
# EMBEDDINGS: For RAG system (Retrieval-Augmented Generation)
# ============================================================================
# Multilingual embeddings for Polish language support
# Used for semantic search in company documentation
#
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# ============================================================================
# CHROMADB: Vector database for document storage
# ============================================================================
# Stores embedded documents and enables similarity search
#
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=company_knowledge

# ============================================================================
# N8N WEBHOOKS: External automation platform
# ============================================================================
# Integration with N8N workflows for calendar, email, and external tools
# Endpoints:
#   /outlook-calendar   - Check calendar availability
#   /outlook-draft      - Create email drafts
#
N8N_WEBHOOK_BASE=http://localhost:5678/webhook

# ============================================================================
# DOCUMENT COMPOSITION STANDARDS (Implicit in Bielik)
# ============================================================================
# These standards are known to Bielik and applied via system prompts.
# No explicit template files needed - Bielik generates them correctly.
#
# Format examples:
#   Formal Reports:
#     - Font: Times New Roman 12pt
#     - Language: Polish (babel)
#     - Structure: Title, Abstract, TOC, Introduction, Body, Conclusion, References
#     - Margins: 2.5cm
#     - Line spacing: 1.5
#
#   Technical Specifications:
#     - Font: Arial 11pt
#     - Language: Polish (babel)
#     - Structure: Title, Overview, Requirements, Architecture, Implementation
#     - Margins: 2cm
#     - Line spacing: 1.2
#
#   Security Procedures:
#     - Font: Times New Roman 12pt
#     - Language: Polish (babel)
#     - Structure: Title, Scope, Objectives, Responsibilities, Steps, Compliance
#     - Margins: 2.5cm
#     - Line spacing: 1.5

# ============================================================================
# TASK PLANNING: Complexity thresholds (can be tuned)
# ============================================================================
# These are implicit in Bielik's task planner role:
#   LOW      - Single step tasks (< 2 steps)
#   MEDIUM   - Multi-step tasks (2-4 steps)
#   HIGH     - Complex tasks (5+ steps or requiring external validation)
#
# Tasks marked as MEDIUM/HIGH automatically enable state persistence

# ============================================================================
# LOGGING AND DEBUGGING
# ============================================================================
# Uncomment to enable verbose logging
#
# LOG_LEVEL=DEBUG
# VERBOSE_PLANNING=true
# SAVE_TASK_LOGS=true

# ============================================================================
# DOCKER SANDBOX CONFIGURATION
# ============================================================================
# Sandbox container names (tool auto-discovers by name pattern)
# Supported: agent_sandbox, python_sandbox, sandbox
#
SANDBOX_CONTAINER_NAME=agent_sandbox

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
# Maximum recursion depth in graph execution
# Increase if complex workflows need more steps
#
GRAPH_RECURSION_LIMIT=50

# Timeout for tool execution (seconds)
TOOL_TIMEOUT=30

# ============================================================================
# For detailed architecture docs, see docs/architecture.md
# ============================================================================
