# Hapilot — environment configuration. Copy to .env and adjust. Every variable is optional.
# All settings are read by src/config.py; model profiles live in config/profiles.yaml.

# --- Models ------------------------------------------------------------------
# Profile used when a chat session does not choose another one (see config/profiles.yaml).
# HAPILOT_PROFILE=reference
# OpenAI-compatible endpoint of the local model server (the model swap proxy). Must be local/LAN.
# HAPILOT_MODEL_URL=http://127.0.0.1:8611/v1
# HAPILOT_PROFILES_FILE=config/profiles.yaml

# --- Agent behaviour ---------------------------------------------------------
# Task planning: auto | explicit | off
# HAPILOT_PLAN_MODE=auto
# Human-in-the-loop: ask (plans > 2 steps, document parameters and confirmations wait for the user)
# or auto (everything runs without asking; used by scripts and evaluation runs)
# HAPILOT_APPROVAL_POLICY=ask
# HAPILOT_RECURSION_LIMIT=50

# --- Knowledge base (embedded ChromaDB, embeddings on CPU) --------------------
# Folder with the company documents to index (.txt, .md, .pdf)
# HAPILOT_DOCS_DIR=examples/demo_company/docs
# HAPILOT_COLLECTION=company_knowledge
# HAPILOT_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# HAPILOT_RAG_TOP_K=4

# --- Sandbox (fresh Docker container per run, no network) ---------------------
# HAPILOT_SANDBOX_IMAGE=hapilot-sandbox:0.1
# HAPILOT_PYTHON_TIMEOUT=60
# HAPILOT_LATEX_TIMEOUT=120
# HAPILOT_SANDBOX_MEMORY=1g
# HAPILOT_SANDBOX_CPUS=1.0
# HAPILOT_SANDBOX_PIDS=128
# Largest .tex (characters) that the editor sends to the model whole; longer files are refused, never cut
# HAPILOT_MAX_EDIT_CHARS=20000

# --- Data directory (workspaces, knowledge base, logs, PID files) --------------
# HAPILOT_DATA_DIR=var

# --- UI --------------------------------------------------------------------------
# Ports used by scripts/hapilotctl.py (all bound to 127.0.0.1)
# HAPILOT_UI_PORT=8601
# HAPILOT_MODELSWAP_PORT=8611
# HAPILOT_BACKEND_PORT=8612
# Optional login: file created by `scripts/hapilotctl.py add-user NAME`
# HAPILOT_UI_USERS_FILE=var/ui_users.txt

# --- Optional n8n extension (Outlook drafts / calendar), off by default ---------
# HAPILOT_N8N_WEBHOOK_BASE=http://127.0.0.1:8678/webhook
# HAPILOT_N8N_PORT=8678
